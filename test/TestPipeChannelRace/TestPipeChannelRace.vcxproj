<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <!-- L31 fix: MSBuild's default OutDir is $(SolutionDir)$(Configuration)\,
       so with a trailing-backslash-less SolutionDir the artifacts land in
       "<repo>Release\" NEXT TO the repo instead of inside it. Pin OutDir and
       IntDir explicitly (same shape as test\TestResponseParser) and default
       SolutionDir to the repo root so a standalone build (no /p:SolutionDir=)
       still resolves inside the repository. -->
  <PropertyGroup Condition="'$(SolutionDir)'==''">
    <SolutionDir>$(MSBuildProjectDirectory)\..\..</SolutionDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <OutDir>$(SolutionDir)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)\msbuild\$(Configuration)\$(Platform)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)\msbuild\$(Configuration)\$(Platform)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <!-- L142: WEASEL_IPC_NO_BOOST_ARCHIVE keeps the boost::archive headers
           out of this translation unit. The boost::archive headers declare an
           explicit specialization of codecvt_null<wchar_t> whose members live
           in the COMPILED boost serialization library, so a translation unit
           that parses them references that library - and its name carries the
           boost version. These tests use no boost::archive at all, and the
           hardcoded F:\b183 path plus the version-stamped 1_83 library names
           they used to carry made the build depend on ONE developer's boost
           install (LNK1104 on the CI runner's boost 1.84.0). -->
      <PreprocessorDefinitions>WIN32;NDEBUG;_CONSOLE;WEASEL_IPC_NO_BOOST_ARCHIVE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>..\..\include;..\..\WeaselIPC;$(BOOST_ROOT)</AdditionalIncludeDirectories>
      <!-- v0.20.0.4 fix: switch RuntimeLibrary to static MultiThreaded. The boost
           static libraries that used to force this are no longer linked at all
           (see L142 in the Link section below), but the static CRT is kept so
           the project stays self-contained and does not drag in the dynamic
           runtime of whatever boost tree happens to be installed. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- L142: no boost library is linked here, and none has to exist on the
           machine. PipeChannel only uses the header-only boost::interprocess
           streams; the boost::archive dependency is kept out of the
           translation unit by WEASEL_IPC_NO_BOOST_ARCHIVE (see the
           PreprocessorDefinitions above). The library directory and the
           version-stamped library names this project used to hardcode
           (F:\b183\... and libboost_*_vc143-mt-s-x32-1_83.lib) made the build
           depend on ONE developer's boost install and fail on the CI runner's
           boost 1.84.0 with LNK1104. If a future change really needs
           boost::archive, link the library explicitly then - and derive its
           name from the boost tree instead of hardcoding a version. -->
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="TestPipeChannelRace.cpp" />
    <!-- v0.20.0.4 fix: PipeChannelBase constructor/destructor are defined in
         WeaselIPC/PipeChannel.cpp. Without this ClCompile entry, the linker
         can't resolve LNK2019 for the symbols (we tested with just the .h
         and got "undefined external" for ~PipeChannelBase() and the ctor). -->
    <ClCompile Include="..\..\WeaselIPC\PipeChannel.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
