{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-installer-path.sh",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard-main-branch-push.py",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-package-publish.sh",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-installer-path.sh",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
